# PR 5739: selective Hazelcast maps. Requires an SBA build containing the PR (SBA_VERSION=... ./buildAndRunAll.sh).
# Equivalent to in-memory-event-store.env, but via SBA properties.
SPRING_BOOT_ADMIN_HAZELCAST_EVENT_STORE_ENABLED=false
SPRING_BOOT_ADMIN_HAZELCAST_SENT_NOTIFICATIONS_ENABLED=true
SPRING_BOOT_ADMIN_HAZELCAST_NOTIFICATION_FILTERS_ENABLED=true
