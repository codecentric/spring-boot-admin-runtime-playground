# Run the SBA nodes with AOT. The env var SPRING_AOT_ENABLED does NOT enable it (spring.aot.enabled is read from
# system properties), so use JAVA_OPTS. The log must say "Starting AOT-processed ...".
# @ConditionalOnProperty is evaluated at build time (relevant for PR 5739): the image is built without the
# properties, so a property set only at runtime must still take effect for the PR to be AOT compatible.
JAVA_OPTS=-Dspring.aot.enabled=true
